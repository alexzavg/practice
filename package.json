{
  "name": "practice",
  "version": "1.0.0",
  "private": true,
  "description": "Практика JS, TS и фреймворков для автотестов",
  "scripts": {
    "test": "npm run test:jest && npm run test:mocha && npm run test:jasmine",
    "test:jest": "jest",
    "test:jest:watch": "jest --watch",
    "test:jest:coverage": "jest --coverage",
    "test:mocha": "mocha",
    "test:mocha:watch": "mocha --watch",
    "test:mocha:coverage": "c8 mocha",
    "test:jasmine": "jasmine --config=\"2. Core testing fundamentals/jasmine/jasmine.json\"",
    "test:jasmine:watch": "nodemon --watch \"2. Core testing fundamentals\" --ext js --exec \"npm run test:jasmine\"",
    "test:jasmine:coverage": "c8 npm run test:jasmine",
    "typecheck": "tsc -p .",
    "format": "prettier --write \"**/*.{js,ts,json}\""
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "^4.5.0",
    "jasmine": "^5.12.0",
    "jest": "^30.2.0",
    "mocha": "^10.8.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3"
  }
}
